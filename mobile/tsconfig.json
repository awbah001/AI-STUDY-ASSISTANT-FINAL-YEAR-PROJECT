{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../shared/*"]
    }
  },
  "include": [
    "app/**/*.ts", "app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx", "../shared/**/*.ts"
  ],
  "exclude": ["node_modules", "../server/**/*.test.ts", "../server/**/*.spec.ts"]
}
