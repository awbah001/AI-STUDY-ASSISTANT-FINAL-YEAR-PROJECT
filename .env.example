# Copy to .env in the repo root. Never commit real secrets.

# Required — at least 16 characters. Used to sign Bearer JWTs.
JWT_SECRET=change-me-to-a-long-random-string

# SQLite (Drizzle / libSQL)
DATABASE_URL=file:./data/app.db

PORT=3000
NODE_ENV=development

# ── AI (Groq — sole LLM provider) ───────────────────────────────────────────
# Create a key at https://console.groq.com/keys
# Never put GROQ_API_KEY in Expo / Vite client env files.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_TIMEOUT_MS=60000
# Speech-to-text model for voice input (web + mobile mic button)
# GROQ_STT_MODEL=whisper-large-v3-turbo
# AI_RATE_LIMIT_PER_MINUTE=30

# Public URL of this server (password-reset links)
APP_URL=http://localhost:3000

# Google Sign-In (same Web client ID is used by the website and Expo)
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_IDS=xxx.apps.googleusercontent.com,yyy.apps.googleusercontent.com
