# Copy to .env in the repo root. Never commit real secrets.

# Required — at least 16 characters. Used to sign Bearer JWTs.
JWT_SECRET=change-me-to-a-long-random-string

# SQLite (Drizzle / libSQL)
DATABASE_URL=file:./data/app.db

PORT=3000
NODE_ENV=development

# LLM — Cognify uses LM Studio by default. You do not need Gemini.
# In LM Studio: load a model, start the local server, then match the model name below.
USE_LOCAL_LLM=true
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=local-model

# Public URL of this server (password-reset links)
APP_URL=http://localhost:3000

# Google Sign-In (same Web client ID is used by the website and Expo)
# Create an OAuth 2.0 Web client in Google Cloud Console.
# Authorized JavaScript origins: http://localhost:3000
# Authorized redirect URIs: http://localhost:3000 and https://auth.expo.io/@your-expo-username/cognify-mobile
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
# Optional extra IDs (Android/iOS clients), comma-separated
# GOOGLE_CLIENT_IDS=xxx.apps.googleusercontent.com,yyy.apps.googleusercontent.com
